#!/usr/bin/env bash
set -euo pipefail
bar_config="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell"
bar_runtime="$HOME/.local/lib/quickshell-bar/runtime/usr"
export PATH="$HOME/.local/bin:$PATH"
export QT_QPA_PLATFORM=wayland
if [[ -x /usr/bin/quickshell ]]; then
    bar_binary=/usr/bin/quickshell
elif [[ -x "$bar_runtime/bin/quickshell" ]]; then
    bar_binary="$bar_runtime/bin/quickshell"
    export LD_LIBRARY_PATH="$bar_runtime/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    export QML_IMPORT_PATH="$bar_runtime/lib/qt6/qml${QML_IMPORT_PATH:+:$QML_IMPORT_PATH}"
    export QT_PLUGIN_PATH="$bar_runtime/lib/qt6/plugins${QT_PLUGIN_PATH:+:$QT_PLUGIN_PATH}"
else
    printf '%s\n' 'Quickshell is missing. Install: sudo pacman -S quickshell' >&2
    exit 1
fi
case "${1:-}" in
    status) exec "$bar_binary" -p "$bar_config" ipc call bar status ;;
    reload) exec "$bar_binary" -p "$bar_config" ipc call bar reload ;;
    stop) exec "$bar_binary" -p "$bar_config" kill ;;
    logs) exec "$bar_binary" -p "$bar_config" log "${@:2}" ;;
    *) exec "$bar_binary" --no-duplicate -p "$bar_config" "$@" ;;
esac
