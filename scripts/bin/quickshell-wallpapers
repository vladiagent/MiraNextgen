#!/usr/bin/env bash
set -euo pipefail
picker_config="$HOME/.config/quickshell-wallpapers"
export QT_QPA_PLATFORM=wayland
case "${1:-}" in
    status) exec quickshell -p "$picker_config" ipc call picker status ;;
    logs) exec quickshell -p "$picker_config" log --tail 30 ;;
    stop) exec quickshell -p "$picker_config" kill ;;
esac
if quickshell -p "$picker_config" ipc call picker close >/dev/null 2>&1; then
    exit 0
fi
exec quickshell --no-duplicate -p "$picker_config"
