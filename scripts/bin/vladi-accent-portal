#!/usr/bin/env python3
"""Supply only the FDO accent setting missing from xdg-desktop-portal-gtk.

All other settings stay with the existing GTK portal. No UI, CSS injection,
process control, or wallpaper generation belongs in this service.
"""
import gi
gi.require_version('Gio', '2.0')
from gi.repository import Gio, GLib

NAME = 'org.freedesktop.impl.portal.desktop.vladiaccent'
PATH = '/org/freedesktop/portal/desktop'
IFACE = 'org.freedesktop.impl.portal.Settings'
NAMESPACE = 'org.freedesktop.appearance'
SWATCHES = {'blue': '#3584e4', 'teal': '#2190a4', 'green': '#3a944a',
            'yellow': '#c88800', 'orange': '#ed5b00', 'red': '#e62d42',
            'pink': '#d56199', 'purple': '#9141ac', 'slate': '#6f8396'}
XML = '''<node><interface name="org.freedesktop.impl.portal.Settings">
<method name="Read"><arg type="s" direction="in"/><arg type="s" direction="in"/><arg type="v" direction="out"/></method>
<method name="ReadAll"><arg type="as" direction="in"/><arg type="a{sa{sv}}" direction="out"/></method>
<signal name="SettingChanged"><arg type="s"/><arg type="s"/><arg type="v"/></signal>
<property name="version" type="u" access="read"/>
</interface></node>'''
settings = Gio.Settings.new('org.gnome.desktop.interface')

def value():
    color = SWATCHES[settings.get_string('accent-color')]
    return GLib.Variant('(ddd)', tuple(int(color[n:n+2], 16) / 255 for n in (1, 3, 5)))

def method(connection, sender, path, interface, name, parameters, invocation):
    args = parameters.unpack()
    if name == 'Read' and args == (NAMESPACE, 'accent-color'):
        invocation.return_value(GLib.Variant('(v)', (value(),)))
    elif name == 'ReadAll':
        patterns = args[0]
        matches = not patterns or any(p == '' or p == NAMESPACE or (p.endswith('*') and NAMESPACE.startswith(p[:-1])) for p in patterns)
        data = {NAMESPACE: {'accent-color': value()}} if matches else {}
        invocation.return_value(GLib.Variant('(a{sa{sv}})', (data,)))
    else:
        invocation.return_dbus_error('org.freedesktop.portal.Error.NotFound', 'This backend supplies only the desktop accent.')

def acquired(connection, name):
    info = Gio.DBusNodeInfo.new_for_xml(XML).interfaces[0]
    connection.register_object(PATH, info, method,
        lambda *args: GLib.Variant('u', 1), None)
    def changed(*unused):
        connection.emit_signal(None, PATH, IFACE, 'SettingChanged',
            GLib.Variant('(ssv)', (NAMESPACE, 'accent-color', value())))
    settings.connect('changed::accent-color', changed)

loop = GLib.MainLoop()
Gio.bus_own_name(Gio.BusType.SESSION, NAME, Gio.BusNameOwnerFlags.NONE,
                 acquired, None, lambda *unused: loop.quit())
loop.run()
