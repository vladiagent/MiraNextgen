#!/usr/bin/env python3
"""Request locking and wait for the compositor's confirmation. No passwords."""
import json
import os
from pathlib import Path
import socket
import sys

options = {'': 'lock', '--suspend': 'suspend', '--status': 'status'}
argument = sys.argv[1] if len(sys.argv) == 2 else ''
if len(sys.argv) > 2 or argument not in options:
    raise SystemExit('Usage: vladi-lock [--suspend | --status]')
path = Path(os.environ.get('XDG_RUNTIME_DIR', '/run/user/' + str(os.getuid()))) / 'vladi-lock/session.sock'
try:
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
        connection.settimeout(8)
        connection.connect(str(path))
        connection.sendall((json.dumps({'command': options[argument]})+'\n').encode())
        response = b''
        while b'\n' not in response and len(response) <= 4096:
            chunk = connection.recv(4096)
            if not chunk:
                break
            response += chunk
    result = json.loads(response)
    if argument == '--status':
        print(json.dumps(result))
    elif argument == '--suspend':
        if not result.get('requested'):
            raise RuntimeError('The session service did not accept the suspend request.')
    elif not result.get('secure'):
        raise RuntimeError('The compositor did not confirm secure locking.')
except (OSError, ValueError, RuntimeError) as error:
    action = 'request suspend' if argument == '--suspend' else 'confirm the lock state'
    print(f'Could not {action}. Check that the Quickshell bar is running.', file=sys.stderr)
    sys.exit(1)
